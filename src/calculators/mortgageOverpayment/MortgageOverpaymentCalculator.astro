---
import AdSlot from '../../components/AdSlot.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import Field from '../../components/Field.astro';
import ResultSummary from '../../components/ResultSummary.astro';
import SelectField from '../../components/SelectField.astro';
import SvgChart from '../../components/SvgChart.astro';
import type { CountryConfig } from '../../countries';
import { createFormatters } from '../../lib/format';
import { buildOverpaymentView, overpaymentDefaults, type MortgageOverpaymentParams } from './model';

interface Props {
  country: CountryConfig;
}

const { country } = Astro.props;
const defaults = country.defaults.mortgageOverpayment;
if (!defaults) throw new Error(`Missing defaults.mortgageOverpayment in the ${country.code} country config`);
const params: MortgageOverpaymentParams = { locale: country.locale, currency: country.currency };
const d = overpaymentDefaults(defaults);
const { view } = buildOverpaymentView(d, params);
if (!view) throw new Error('Mortgage overpayment defaults are invalid');
const f = createFormatters(country.locale, country.currency);
const sym = country.currencySymbol;
---

<div class="calc-block" data-calc="mortgage-overpayment" data-locale={country.locale} data-currency={country.currency} data-params={JSON.stringify(params)}>
  <CalculatorShell id="overpay" label="Mortgage overpayment calculator">
    <Fragment slot="inputs">
      <fieldset class="field-group">
        <legend>Your mortgage</legend>
        <Field id="mo-balance" field="balance" label="Amount you still owe" value={f.number(d.balance)} prefix={sym} money />
        <Field id="mo-rate" field="ratePercent" label="Interest rate" value={String(d.ratePercent)} suffix="%" hint="Your current rate. If it will change when a fixed deal ends, try the new rate too." />
        <Field id="mo-years" field="years" label="Time left on your mortgage" value={String(d.years)} suffix="years" hint="Decimals work: 22.5 is 22 years 6 months." />
      </fieldset>
      <fieldset class="field-group">
        <legend>Your overpayments</legend>
        <Field id="mo-monthly" field="monthlyOverpayment" label="Overpay each month" value={f.number(d.monthlyOverpayment)} prefix={sym} money optional />
        <Field id="mo-lump" field="lumpSum" label="One-off lump sum" value={f.number(d.lumpSum)} prefix={sym} money optional />
        <Field id="mo-lumpmonth" field="lumpSumMonth" label="Pay the lump sum in month" value={String(d.lumpSumMonth)} inputmode="numeric" hint="1 is with your next payment; 12 is a year from now." />
        <SelectField
          id="mo-mode"
          field="mode"
          label="What overpayments should do"
          value={d.mode}
          options={[
            { value: 'shorterTerm', label: 'Pay my mortgage off sooner' },
            { value: 'lowerPayment', label: 'Lower my monthly payment' },
          ]}
          hint="Lenders often let you choose. Paying off sooner usually saves more interest."
        />
        <Field id="mo-allow" field="allowancePercent" label="Yearly overpayment allowance" value={String(d.allowancePercent)} suffix="% of balance" hint="The most you can overpay each year before early repayment charges. Check your mortgage offer." />
      </fieldset>
    </Fragment>
    <Fragment slot="results">
      <div class="result-main">
        <p class="result-label">Interest saved</p>
        <p class="result-figure" data-out="saved">{view.saved}</p>
        <p class="result-sub" data-out="savedSub">{view.savedSub}</p>
      </div>
      <dl class="result-list">
        <div><dt>Monthly payment now</dt><dd data-out="payment">{view.payment}</dd></div>
        <div><dt data-out="secondLabel">{view.secondLabel}</dt><dd data-out="secondValue">{view.secondValue}</dd></div>
        <div><dt>Total interest</dt><dd data-out="totalInterest">{view.totalInterest}</dd></div>
      </dl>
      <table class="compare-table">
        <thead><tr><th scope="col"><span class="visually-hidden">Item</span></th><th scope="col">Without</th><th scope="col">With overpaying</th></tr></thead>
        <tbody>
          <tr><th scope="row">Time to pay off</th><td data-out="withoutTime">{view.withoutTime}</td><td data-out="withTime">{view.withTime}</td></tr>
          <tr><th scope="row">Total interest</th><td data-out="withoutInterest">{view.withoutInterest}</td><td data-out="withInterest">{view.withInterest}</td></tr>
        </tbody>
      </table>
      <p class="result-warn" data-show="hasWarning" hidden={!view.hasWarning} data-out="warning">{view.warning}</p>
      <ResultSummary text={view.summary} />
    </Fragment>
  </CalculatorShell>

  <AdSlot name="results" />

  <section class="card breakdown" aria-labelledby="mo-breakdown-title">
    <h2 id="mo-breakdown-title" class="h3">Your mortgage balance over time</h2>
    <SvgChart
      id="mo-chart"
      title="Balance left at the end of each year"
      legend={[
        { label: 'With overpayments', className: 'chart-s1' },
        { label: 'Without overpaying', className: 'chart-s4' },
      ]}
      svg={view.chartSvg}
      htmlKey="chartSvg"
    />
    <details class="schedule">
      <summary>Year-by-year table</summary>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Year-by-year table">
        <table class="data-table">
          <thead><tr><th scope="col">Year</th><th scope="col">Paid</th><th scope="col">Overpaid</th><th scope="col">Interest</th><th scope="col">Balance</th><th scope="col">Without overpaying</th></tr></thead>
          <tbody data-html="yearRows" set:html={view.yearRows} />
        </table>
      </div>
    </details>
    <div class="formula">
      <h3>How this is calculated</h3>
      <p class="formula-eq"><code>M = P × r ÷ (1 − (1 + r)<sup>−n</sup>)</code></p>
      <ul>
        <li><strong>M</strong> is your monthly payment, <strong>P</strong> what you owe, <strong>n</strong> the months left and <strong>r</strong> the monthly rate: annual rate ÷ 12 ÷ 100.</li>
        <li>Each month, interest = balance × r. Your payment covers the interest and some of the balance; overpayments come straight off the balance.</li>
        <li><strong>Pay off sooner:</strong> the payment stays the same, so the mortgage ends early. <strong>Lower payments:</strong> the payment is worked out again each month over the time left on your original term.</li>
        <li>Years where overpayments go over your allowance (a % of the balance at the start of the year) are highlighted. Some lenders work out interest daily, so your statement may differ slightly. Figures are calculated at full precision and rounded for display.</li>
      </ul>
    </div>
  </section>
</div>

<script>
  import { bindCalculator, embeddedParams } from '../../lib/calcUi';
  import { buildOverpaymentView, readOverpaymentInput, type MortgageOverpaymentParams } from './model';

  for (const root of document.querySelectorAll<HTMLElement>('[data-calc="mortgage-overpayment"]')) {
    const params = embeddedParams<MortgageOverpaymentParams>(root);
    bindCalculator(root, (read) => buildOverpaymentView(readOverpaymentInput(read), params));
  }
</script>
