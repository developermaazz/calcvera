---
import AdSlot from '../../components/AdSlot.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import Field from '../../components/Field.astro';
import ResultSummary from '../../components/ResultSummary.astro';
import SelectField from '../../components/SelectField.astro';
import SvgChart from '../../components/SvgChart.astro';
import type { CountryConfig } from '../../countries';
import { createFormatters } from '../../lib/format';
import { buildCompoundInterestView, compoundDefaults, type CompoundInterestParams } from './model';

interface Props {
  country: CountryConfig;
}

const { country } = Astro.props;
const defaults = country.defaults.compoundInterest;
if (!defaults) throw new Error(`Missing defaults.compoundInterest in the ${country.code} country config`);
const uk = country.code === 'uk';
const params: CompoundInterestParams = { locale: country.locale, currency: country.currency, rateName: uk ? 'AER' : 'APY' };
const d = compoundDefaults(defaults);
const { view } = buildCompoundInterestView(d, params);
if (!view) throw new Error('Compound interest defaults are invalid');
const f = createFormatters(country.locale, country.currency);
const sym = country.currencySymbol;
---

<div class="calc-block" data-calc="compound-interest" data-locale={country.locale} data-currency={country.currency} data-params={JSON.stringify(params)}>
  <CalculatorShell id="compound" label="Compound interest calculator">
    <Fragment slot="inputs">
      <Field id="ci-initial" field="initialDeposit" label="Starting amount" value={f.number(d.initialDeposit)} prefix={sym} money />
      <Field id="ci-monthly" field="monthlyDeposit" label="Monthly deposit" value={f.number(d.monthlyDeposit)} prefix={sym} money optional />
      <Field id="ci-rate" field="annualRatePercent" label="Annual interest rate" value={String(d.annualRatePercent)} suffix="%" hint={`The stated yearly rate before compounding. If you only know the ${params.rateName}, enter it and choose "Annually".`} />
      <SelectField
        id="ci-compounding"
        field="compounding"
        label="Interest compounds"
        value={d.compounding}
        options={[
          { value: 'daily', label: 'Daily' },
          { value: 'monthly', label: 'Monthly' },
          { value: 'quarterly', label: 'Quarterly' },
          { value: 'semiannually', label: 'Twice a year' },
          { value: 'annually', label: 'Annually' },
        ]}
      />
      <Field id="ci-years" field="years" label="How long" value={String(d.years)} suffix="years" inputmode="numeric" />
      <SelectField
        id="ci-timing"
        field="timing"
        label="Deposits are made at the"
        value={d.timing}
        options={[
          { value: 'end', label: 'End of each month' },
          { value: 'start', label: 'Start of each month' },
        ]}
      />
    </Fragment>
    <Fragment slot="results">
      <div class="result-main">
        <p class="result-label" data-out="balanceLabel">{view.balanceLabel}</p>
        <p class="result-figure" data-out="finalBalance">{view.finalBalance}</p>
      </div>
      <dl class="result-list">
        <div><dt>You put in</dt><dd data-out="totalDeposits">{view.totalDeposits}</dd></div>
        <div><dt>Interest earned</dt><dd class="positive" data-out="totalInterest">{view.totalInterest}</dd></div>
        <div><dt>{params.rateName} (yearly growth)</dt><dd data-out="effectiveRate">{view.effectiveRate}</dd></div>
      </dl>
      <p class="result-note">Interest makes up <span data-out="interestShare">{view.interestShare}</span> of the final balance.</p>
      <ResultSummary text={view.summary} />
    </Fragment>
  </CalculatorShell>

  <AdSlot name="results" />

  <section class="card breakdown" aria-labelledby="ci-breakdown-title">
    <h2 id="ci-breakdown-title" class="h3">How your money grows</h2>
    <SvgChart
      id="ci-chart"
      title="Balance at the end of each year"
      legend={[
        { label: 'Money you put in', className: 'chart-s1' },
        { label: 'Interest', className: 'chart-s3' },
      ]}
      svg={view.chartSvg}
      htmlKey="chartSvg"
    />
    <details class="schedule">
      <summary>Year-by-year table</summary>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Year-by-year table">
        <table class="data-table">
          <thead><tr><th scope="col">Year</th><th scope="col">Deposits</th><th scope="col">Interest</th><th scope="col">Total interest</th><th scope="col">Balance</th></tr></thead>
          <tbody data-html="yearRows" set:html={view.yearRows} />
        </table>
      </div>
    </details>
    <div class="formula">
      <h3>How this is calculated</h3>
      <p class="formula-eq"><code>i = (1 + r ÷ n)<sup>n ÷ 12</sup> − 1</code></p>
      <ul>
        <li><strong>r</strong> is the annual rate and <strong>n</strong> how many times a year it compounds (365 for daily). <strong>i</strong> is the matching monthly rate, so each month's growth adds up to exactly the same yearly growth.</li>
        <li>Each month the balance grows by i, and your deposit is added at the start or end of the month.</li>
        <li>A lump sum on its own grows to P × (1 + r ÷ n)<sup>n × t</sup> after t years.</li>
        <li><strong>{params.rateName}</strong> = (1 + r ÷ n)<sup>n</sup> − 1, the yearly growth after compounding.</li>
        <li>No tax, fees or inflation are included, and the rate stays the same throughout. Figures are calculated at full precision and rounded for display.</li>
      </ul>
    </div>
  </section>
</div>

<script>
  import { bindCalculator, embeddedParams } from '../../lib/calcUi';
  import { buildCompoundInterestView, readCompoundInterestInput, type CompoundInterestParams } from './model';

  for (const root of document.querySelectorAll<HTMLElement>('[data-calc="compound-interest"]')) {
    const params = embeddedParams<CompoundInterestParams>(root);
    bindCalculator(root, (read) => buildCompoundInterestView(readCompoundInterestInput(read), params));
  }
</script>
