---
import AdSlot from '../../components/AdSlot.astro';
import AmortizationTable from '../../components/AmortizationTable.astro';
import CalculatorShell from '../../components/CalculatorShell.astro';
import CheckboxField from '../../components/CheckboxField.astro';
import Field from '../../components/Field.astro';
import ResultSummary from '../../components/ResultSummary.astro';
import SelectField from '../../components/SelectField.astro';
import SvgChart from '../../components/SvgChart.astro';
import type { CountryConfig } from '../../countries';
import { createFormatters } from '../../lib/format';
import { USED_CAR_TERMS, buildUsedCarLoanView, usedCarDefaults, type UsedCarLoanParams } from './model';

interface Props {
  country: CountryConfig;
}

const { country } = Astro.props;
const defaults = country.defaults.usedCarLoan;
if (!defaults) throw new Error(`Missing defaults.usedCarLoan in the ${country.code} country config`);
const params: UsedCarLoanParams = { locale: country.locale, currency: country.currency };
const d = usedCarDefaults(defaults);
const { view } = buildUsedCarLoanView(d, params);
if (!view) throw new Error('Used car loan defaults are invalid');
const f = createFormatters(country.locale, country.currency);
const sym = country.currencySymbol;
---

<div class="calc-block" data-calc="used-car" data-locale={country.locale} data-currency={country.currency} data-params={JSON.stringify(params)}>
  <CalculatorShell id="uc" label="Used car loan calculator">
    <Fragment slot="inputs">
      <Field id="uc-price" field="price" label="Car price" value={f.number(d.price)} prefix={sym} money hint="The agreed price before tax and fees." />
      <Field id="uc-down" field="downPayment" label="Down payment" value={f.number(d.downPayment)} prefix={sym} money />
      <Field id="uc-trade" field="tradeInValue" label="Trade-in value" value={f.number(d.tradeInValue)} prefix={sym} money />
      <Field id="uc-owed" field="tradeInOwed" label="Amount owed on trade-in" value={f.number(d.tradeInOwed)} prefix={sym} money />
      <Field id="uc-tax" field="salesTaxPercent" label="Sales tax rate" value={String(d.salesTaxPercent)} suffix="%" hint="Your state plus any local rate." />
      <Field id="uc-fees" field="fees" label="Fees (dealer, title, registration)" value={f.number(d.fees)} prefix={sym} money hint="Assumed to be added to the loan." />
      <Field id="uc-apr" field="aprPercent" label="Interest rate (APR)" value={String(d.aprPercent)} suffix="%" />
      <SelectField
        id="uc-term"
        field="termMonths"
        label="Loan term"
        value={String(d.termMonths)}
        options={USED_CAR_TERMS.map((m) => ({ value: String(m), label: `${m} months (${m / 12} years)` }))}
      />
      <CheckboxField id="uc-taxcredit" field="taxAfterTradeIn" label="My state charges sales tax after subtracting the trade-in" checked={d.taxAfterTradeIn} hint="Rules vary by state. Check with your state's tax or motor vehicle agency." />
    </Fragment>
    <Fragment slot="results">
      <div class="result-main">
        <p class="result-label" data-out="headlineLabel">{view.headlineLabel}</p>
        <p class="result-figure" data-out="headline">{view.headline}</p>
      </div>
      <dl class="result-list">
        <div><dt>Amount financed</dt><dd data-out="loanAmount">{view.loanAmount}</dd></div>
        <div><dt>Sales tax</dt><dd data-out="salesTax">{view.salesTax}</dd></div>
        <div><dt>Total interest</dt><dd data-out="totalInterest">{view.totalInterest}</dd></div>
        <div><dt>Total cost of the car</dt><dd data-out="totalCost">{view.totalCost}</dd></div>
        <div><dt>Paid off by</dt><dd data-out="payoffDate">{view.payoffDate}</dd></div>
      </dl>
      <ResultSummary text={view.summary} />
    </Fragment>
  </CalculatorShell>

  <AdSlot name="results" />

  <section class="card breakdown" aria-labelledby="uc-breakdown-title">
    <h2 id="uc-breakdown-title" class="h3">What you're financing</h2>
    <div class="table-scroll table-plain">
      <table class="data-table"><tbody data-html="financedHtml" set:html={view.financedHtml} /></table>
    </div>
    <div data-show="hasLoan" hidden={!view.hasLoan}>
      <SvgChart
        id="uc-chart"
        title="Principal and interest repaid each year"
        legend={[
          { label: 'Principal', className: 'chart-s1' },
          { label: 'Interest', className: 'chart-s2' },
        ]}
        svg={view.chartSvg}
        htmlKey="chartSvg"
      />
      <AmortizationTable
        summary="Repayment schedule"
        views={[
          { id: 'yearly', label: 'By year', headers: ['Year', 'Principal', 'Interest', 'Balance'], rowsHtml: view.yearlyRows },
          { id: 'monthly', label: 'By month', headers: ['#', 'Month', 'Payment', 'Principal', 'Interest', 'Balance'], rowsHtml: view.monthlyRows },
        ]}
      />
    </div>
    <div class="formula">
      <h3>How this is calculated</h3>
      <ul>
        <li><strong>Amount financed</strong> = price − down payment − (trade-in value − amount owed) + sales tax + fees.</li>
        <li><strong>Sales tax</strong> = tax rate × price, or × (price − trade-in value) if your state taxes the price after the trade-in.</li>
        <li><strong>Monthly payment</strong> = loan × r ÷ (1 − (1 + r)<sup>−n</sup>), with r = APR ÷ 12 ÷ 100 and n = months. At 0% APR it's the loan ÷ n.</li>
        <li><strong>Total cost of the car</strong> = price + sales tax + fees + interest. The last payment is adjusted so the balance ends at exactly zero.</li>
      </ul>
    </div>
  </section>
</div>

<script>
  import { bindCalculator, embeddedParams } from '../../lib/calcUi';
  import { buildUsedCarLoanView, readCarLoanInput, type UsedCarLoanParams } from './model';

  for (const root of document.querySelectorAll<HTMLElement>('[data-calc="used-car"]')) {
    const params = embeddedParams<UsedCarLoanParams>(root);
    const schedule = root.querySelector<HTMLDetailsElement>('[data-schedule]');
    const monthlyBody = root.querySelector<HTMLElement>('[data-rows="monthly"]');
    const yearlyBody = root.querySelector<HTMLElement>('[data-rows="yearly"]');
    bindCalculator(root, (read) => {
      const computed = buildUsedCarLoanView(readCarLoanInput(read), params);
      if (computed.view) {
        if (yearlyBody) yearlyBody.innerHTML = computed.view.yearlyRows;
        if (monthlyBody && schedule?.open) monthlyBody.innerHTML = computed.view.monthlyRows;
        if (monthlyBody && !schedule?.open) monthlyBody.dataset.pending = computed.view.monthlyRows;
      }
      return computed;
    });
    schedule?.addEventListener('toggle', () => {
      if (schedule.open && monthlyBody?.dataset.pending) {
        monthlyBody.innerHTML = monthlyBody.dataset.pending;
        delete monthlyBody.dataset.pending;
      }
    });
  }
</script>
