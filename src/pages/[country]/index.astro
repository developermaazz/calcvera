---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Flag from '../../components/Flag.astro';
import Icon from '../../components/Icon.astro';
import { CATEGORY_ICONS, CATEGORY_TINTS, ENGINE_ICONS } from '../../lib/icons';
import { CATEGORY_LABELS, calculatorPath, calculatorsFor, type Category } from '../../calculators/registry';
import { SITE } from '../../config/site';
import { LAUNCHED_COUNTRIES, getCountry, type CountryCode } from '../../countries';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return LAUNCHED_COUNTRIES.map((c) => ({ params: { country: c.code } }));
}

const country = getCountry(Astro.params.country);
const calculators = calculatorsFor(country.code);

const byCategory = new Map<Category, typeof calculators>();
for (const calc of calculators) {
  byCategory.set(calc.category, [...(byCategory.get(calc.category) ?? []), calc]);
}

const alternates: Partial<Record<CountryCode, string>> = Object.fromEntries(
  LAUNCHED_COUNTRIES.map((c) => [c.code, `/${c.code}/`]),
);

const longTitle = `Free ${country.adjective} Finance Calculators: Loans, Debt & Tax`;
const title = longTitle.length + SITE.name.length + 3 <= 60 ? `${longTitle} | ${SITE.name}` : longTitle;
const description = `Free ${country.adjective} calculators for loans, debt, tax, savings and retirement, built on ${country.adjective} rules and figures.`;
const pageUrl = new URL(`/${country.code}/`, SITE.url).href;

const jsonLd = [
  {
    '@type': 'CollectionPage',
    '@id': `${pageUrl}#page`,
    name: `${country.adjective} finance calculators`,
    url: pageUrl,
    inLanguage: country.locale,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: `${country.adjective} calculators`, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={description} country={country} alternates={alternates} xDefault="/" jsonLd={jsonLd}>
  <div class="page-head grid-motif">
    <div class="page-wide">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: `${country.adjective} calculators`, href: `/${country.code}/` },
        ]}
      />
      <div class="hub-title">
        <Flag code={country.code} size={42} />
        <h1>{country.adjective} finance calculators</h1>
      </div>
      <p class="lead">
        Calculators built on {country.name} rules, in {country.currency}. Tax figures are for the {country.taxYear} tax year.
      </p>
      <ul class="chips">
        <li class="chip">{country.currency}</li>
        <li class="chip chip-accent"><Icon name="calendar" size={15} />{country.taxYear} tax year</li>
        <li class="chip">{calculators.length} {calculators.length === 1 ? 'calculator' : 'calculators'}</li>
      </ul>
    </div>
  </div>

  <div class="page-wide">
    {
      byCategory.size > 1 && (
        <nav class="cat-nav" aria-label="Categories">
          <ul>
            {[...byCategory.entries()].map(([category, calcs]) => (
              <li>
                <a class="chip" href={`#cat-${category}`}>
                  {CATEGORY_LABELS[category]} <span class="count">{calcs.length}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      [...byCategory.entries()].map(([category, calcs]) => (
        <section class="hub-section" aria-labelledby={`cat-${category}`}>
          <div class="cat-head">
            <span class:list={['icon-tile', `tint-${CATEGORY_TINTS[category]}`]}>
              <Icon name={CATEGORY_ICONS[category]} size={22} />
            </span>
            <h2 id={`cat-${category}`}>{CATEGORY_LABELS[category]}</h2>
            <span class="count">{calcs.length}</span>
          </div>
          <ul class="card-list">
            {calcs.map((calc) => (
              <li>
                <a class="link-card" href={calculatorPath(country.code, calc.slug)}>
                  <span class="card-top">
                    <span class:list={['icon-tile', 'icon-tile-sm', `tint-${CATEGORY_TINTS[category]}`]}>
                      <Icon name={ENGINE_ICONS[calc.engine]} size={18} />
                    </span>
                  </span>
                  <strong>{calc.name}</strong>
                  <span class="card-desc">{calc.blurb}</span>
                  <span class="card-arrow" aria-hidden="true">
                    <Icon name="arrowRight" size={18} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }

    <div class="roadmap-note">
      <Icon name="lightbulb" size={20} />
      <p>More {country.adjective} calculators are on the way. Each one ships only after its maths is tested.</p>
    </div>
  </div>
</BaseLayout>
