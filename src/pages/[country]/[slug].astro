---
import { getEntry, render } from 'astro:content';
import AutoRefinanceCalculator from '../../calculators/autoRefinance/AutoRefinanceCalculator.astro';
import CarAffordabilityCalculator from '../../calculators/carAffordability/CarAffordabilityCalculator.astro';
import CarFinanceCalculator from '../../calculators/carFinance/CarFinanceCalculator.astro';
import RetirementMatchCalculator from '../../calculators/retirementMatch/RetirementMatchCalculator.astro';
import StudentLoanCalculator from '../../calculators/studentLoan/StudentLoanCalculator.astro';
import CreditCardPayoffCalculator from '../../calculators/creditCardPayoff/CreditCardPayoffCalculator.astro';
import DebtConsolidationCalculator from '../../calculators/debtConsolidation/DebtConsolidationCalculator.astro';
import DebtSnowballCalculator from '../../calculators/debtSnowball/DebtSnowballCalculator.astro';
import CompoundInterestCalculator from '../../calculators/compoundInterest/CompoundInterestCalculator.astro';
import SavingsGoalCalculator from '../../calculators/savingsGoal/SavingsGoalCalculator.astro';
import RentVsBuyCalculator from '../../calculators/rentVsBuy/RentVsBuyCalculator.astro';
import PaycheckCalculator from '../../calculators/paycheck/PaycheckCalculator.astro';
import PensionTaxReliefCalculator from '../../calculators/pensionTaxRelief/PensionTaxReliefCalculator.astro';
import MortgageOverpaymentCalculator from '../../calculators/mortgageOverpayment/MortgageOverpaymentCalculator.astro';
import IsaSavingsCalculator from '../../calculators/isaSavings/IsaSavingsCalculator.astro';
import RothIraCalculator from '../../calculators/rothIra/RothIraCalculator.astro';
import HelocCalculator from '../../calculators/heloc/HelocCalculator.astro';
import CaMortgageCalculator from '../../calculators/caMortgage/CaMortgageCalculator.astro';
import AuTakeHomeCalculator from '../../calculators/auTakeHome/AuTakeHomeCalculator.astro';
import CaTakeHomeCalculator from '../../calculators/caTakeHome/CaTakeHomeCalculator.astro';
import AuSuperCalculator from '../../calculators/auSuper/AuSuperCalculator.astro';
import AuHomeLoanCalculator from '../../calculators/auHomeLoan/AuHomeLoanCalculator.astro';
import HelpDebtCalculator from '../../calculators/helpDebt/HelpDebtCalculator.astro';
import RrspVsTfsaCalculator from '../../calculators/rrspVsTfsa/RrspVsTfsaCalculator.astro';
import CppCalculator from '../../calculators/cppTiming/CppCalculator.astro';
import LandTransferCalculator from '../../calculators/caLandTransfer/LandTransferCalculator.astro';
import AuStampDutyCalculator from '../../calculators/auStampDuty/AuStampDutyCalculator.astro';
import EmiCalculator from '../../calculators/emi/EmiCalculator.astro';
import SipCalculator from '../../calculators/sip/SipCalculator.astro';
import PpfCalculator from '../../calculators/ppf/PpfCalculator.astro';
import InIncomeTaxCalculator from '../../calculators/inIncomeTax/InIncomeTaxCalculator.astro';
import DtiCalculator from '../../calculators/dti/DtiCalculator.astro';
import FhsaCalculator from '../../calculators/fhsa/FhsaCalculator.astro';
import InheritanceTaxCalculator from '../../calculators/inheritanceTax/InheritanceTaxCalculator.astro';
import LoanCalculator from '../../calculators/loan/LoanCalculator.astro';
import NovatedLeaseCalculator from '../../calculators/novatedLease/NovatedLeaseCalculator.astro';
import PersonalLoanPayoffCalculator from '../../calculators/personalLoanPayoff/PersonalLoanPayoffCalculator.astro';
import QuarterlyTaxCalculator from '../../calculators/quarterlyTax/QuarterlyTaxCalculator.astro';
import RedundancyPayCalculator from '../../calculators/redundancyPay/RedundancyPayCalculator.astro';
import StampDutyCalculator from '../../calculators/stampDuty/StampDutyCalculator.astro';
import TakeHomePayCalculator from '../../calculators/takeHomePay/TakeHomePayCalculator.astro';
import UsedCarLoanCalculator from '../../calculators/usedCarLoan/UsedCarLoanCalculator.astro';
import { CALCULATORS, forCountry, getCalculator, liveCountries, type EngineName } from '../../calculators/registry';
import { getCountry } from '../../countries';
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

export function getStaticPaths() {
  return CALCULATORS.flatMap((calc) =>
    liveCountries(calc).map((country) => ({ params: { country, slug: calc.slug } })),
  );
}

/** Engine → calculator UI. Add one line per new engine when its calculator is built. */
const ENGINE_UI: Partial<Record<EngineName, typeof LoanCalculator>> = {
  loan: LoanCalculator,
  creditCardPayoff: CreditCardPayoffCalculator,
  personalLoanPayoff: PersonalLoanPayoffCalculator,
  usedCarLoan: UsedCarLoanCalculator,
  takeHomePay: TakeHomePayCalculator,
  stampDuty: StampDutyCalculator,
  autoRefinance: AutoRefinanceCalculator,
  retirementMatch: RetirementMatchCalculator,
  studentLoan: StudentLoanCalculator,
  carFinance: CarFinanceCalculator,
  dti: DtiCalculator,
  carAffordability: CarAffordabilityCalculator,
  debtConsolidation: DebtConsolidationCalculator,
  debtSnowball: DebtSnowballCalculator,
  compoundInterest: CompoundInterestCalculator,
  savingsGoal: SavingsGoalCalculator,
  rentVsBuy: RentVsBuyCalculator,
  paycheck: PaycheckCalculator,
  pensionTaxRelief: PensionTaxReliefCalculator,
  mortgageOverpayment: MortgageOverpaymentCalculator,
  isaSavings: IsaSavingsCalculator,
  rothIra: RothIraCalculator,
  heloc: HelocCalculator,
  caMortgage: CaMortgageCalculator,
  auTakeHome: AuTakeHomeCalculator,
  caTakeHome: CaTakeHomeCalculator,
  auSuper: AuSuperCalculator,
  auHomeLoan: AuHomeLoanCalculator,
  helpDebt: HelpDebtCalculator,
  rrspVsTfsa: RrspVsTfsaCalculator,
  cppTiming: CppCalculator,
  caLandTransfer: LandTransferCalculator,
  auStampDuty: AuStampDutyCalculator,
  emi: EmiCalculator,
  sip: SipCalculator,
  ppf: PpfCalculator,
  inIncomeTax: InIncomeTaxCalculator,
  redundancyPay: RedundancyPayCalculator,
  inheritanceTax: InheritanceTaxCalculator,
  selfEmploymentTax: QuarterlyTaxCalculator,
  fhsa: FhsaCalculator,
  novatedLease: NovatedLeaseCalculator,
};

const { country: countryCode, slug } = Astro.params;
const country = getCountry(countryCode);
const calc = forCountry(getCalculator(slug), country.code);

const guide = await getEntry('guides', `${country.code}/${calc.slug}`);
if (!guide) {
  throw new Error(`Missing guide: src/content/guides/${country.code}/${calc.slug}.md (every calculator page needs one)`);
}
const { Content, headings } = await render(guide);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
const Calculator = ENGINE_UI[calc.engine];
if (!Calculator) throw new Error(`No UI registered for engine "${calc.engine}" (${calc.slug})`);
---

<CalculatorLayout country={country} calc={calc} guide={guide.data} toc={toc}>
  <Calculator country={country} />
  <Fragment slot="guide">
    <Content />
  </Fragment>
</CalculatorLayout>
