---
import { getEntry, render } from 'astro:content';
import CarAffordabilityCalculator from '../../calculators/carAffordability/CarAffordabilityCalculator.astro';
import CreditCardPayoffCalculator from '../../calculators/creditCardPayoff/CreditCardPayoffCalculator.astro';
import DebtConsolidationCalculator from '../../calculators/debtConsolidation/DebtConsolidationCalculator.astro';
import DtiCalculator from '../../calculators/dti/DtiCalculator.astro';
import FhsaCalculator from '../../calculators/fhsa/FhsaCalculator.astro';
import InheritanceTaxCalculator from '../../calculators/inheritanceTax/InheritanceTaxCalculator.astro';
import LoanCalculator from '../../calculators/loan/LoanCalculator.astro';
import NovatedLeaseCalculator from '../../calculators/novatedLease/NovatedLeaseCalculator.astro';
import QuarterlyTaxCalculator from '../../calculators/quarterlyTax/QuarterlyTaxCalculator.astro';
import RedundancyPayCalculator from '../../calculators/redundancyPay/RedundancyPayCalculator.astro';
import { CALCULATORS, getCalculator, liveCountries, type EngineName } from '../../calculators/registry';
import { getCountry } from '../../countries';
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';

export function getStaticPaths() {
  return CALCULATORS.flatMap((calc) =>
    liveCountries(calc).map((country) => ({ params: { country, slug: calc.slug } })),
  );
}

/** Engine → calculator UI. Add one line per new engine when its calculator is built. */
const ENGINE_UI: Partial<Record<EngineName, typeof LoanCalculator>> = {
  loan: LoanCalculator,
  creditCardPayoff: CreditCardPayoffCalculator,
  dti: DtiCalculator,
  carAffordability: CarAffordabilityCalculator,
  debtConsolidation: DebtConsolidationCalculator,
  redundancyPay: RedundancyPayCalculator,
  inheritanceTax: InheritanceTaxCalculator,
  selfEmploymentTax: QuarterlyTaxCalculator,
  fhsa: FhsaCalculator,
  novatedLease: NovatedLeaseCalculator,
};

const { country: countryCode, slug } = Astro.params;
const country = getCountry(countryCode);
const calc = getCalculator(slug);

const guide = await getEntry('guides', `${country.code}/${calc.slug}`);
if (!guide) {
  throw new Error(`Missing guide: src/content/guides/${country.code}/${calc.slug}.md (every calculator page needs one)`);
}
const { Content } = await render(guide);
const Calculator = ENGINE_UI[calc.engine];
if (!Calculator) throw new Error(`No UI registered for engine "${calc.engine}" (${calc.slug})`);
---

<CalculatorLayout country={country} calc={calc} guide={guide.data}>
  <Calculator country={country} />
  <Fragment slot="guide">
    <Content />
  </Fragment>
</CalculatorLayout>
