---
/**
 * Every calculator page: breadcrumb, H1, intro, calculator, guide, FAQ, related, sources, disclaimer.
 * The default slot is the calculator; the "guide" slot is the rendered markdown guide.
 */
import AdSlot from '../components/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Disclaimer from '../components/Disclaimer.astro';
import FAQ from '../components/FAQ.astro';
import Flag from '../components/Flag.astro';
import Icon from '../components/Icon.astro';
import RelatedCalculators from '../components/RelatedCalculators.astro';
import { calculatorPath, liveCountries, relatedFor, type CalculatorEntry } from '../calculators/registry';
import { SITE } from '../config/site';
import type { CountryCode, CountryConfig } from '../countries';
import BaseLayout from './BaseLayout.astro';

export interface GuideMeta {
  h1: string;
  description: string;
  intro: string;
  updated: Date;
  faqs: { q: string; a: string }[];
  sources: { name: string; url: string }[];
}

interface Props {
  country: CountryConfig;
  calc: CalculatorEntry;
  guide: GuideMeta;
  /** The guide's H2s, for the "On this page" list. */
  toc?: { slug: string; text: string }[];
}

const { country, calc, guide, toc = [] } = Astro.props;

const fullTitle = `${calc.name} (${country.shortName}) | ${SITE.name}`;
const title = fullTitle.length <= 60 ? fullTitle : `${calc.name} (${country.shortName})`;

const alternates: Partial<Record<CountryCode, string>> = Object.fromEntries(
  liveCountries(calc).map((code) => [code, calculatorPath(code, calc.slug)]),
);

const pageUrl = new URL(calculatorPath(country.code, calc.slug), SITE.url).href;
const hubUrl = new URL(`/${country.code}/`, SITE.url).href;
const updatedLabel = new Intl.DateTimeFormat(country.locale, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
  guide.updated,
);

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: `${country.adjective} calculators`, href: `/${country.code}/` },
  { name: guide.h1, href: calculatorPath(country.code, calc.slug) },
];

const jsonLd = [
  {
    '@type': 'WebApplication',
    '@id': `${pageUrl}#app`,
    name: guide.h1,
    url: pageUrl,
    description: guide.description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    inLanguage: country.locale,
    dateModified: guide.updated.toISOString().slice(0, 10),
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: country.currency },
    publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  },
  {
    '@type': 'FAQPage',
    '@id': `${pageUrl}#faq`,
    mainEntity: guide.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${pageUrl}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' },
      { '@type': 'ListItem', position: 2, name: `${country.adjective} calculators`, item: hubUrl },
      { '@type': 'ListItem', position: 3, name: guide.h1, item: pageUrl },
    ],
  },
];
---

<BaseLayout title={title} description={guide.description} country={country} alternates={alternates} jsonLd={jsonLd}>
  <div class="calc-head grid-motif">
    <div class="page-wide">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{guide.h1}</h1>
      <p class="lead">{guide.intro}</p>
      <ul class="meta-chips">
        <li class="chip"><Flag code={country.code} size={16} />{country.name} · {country.currency}</li>
        {calc.usesTaxYear && <li class="tax-year-note">Updated for the {country.taxYear} tax year.</li>}
        <li class="chip"><Icon name="calendar" size={15} />Last updated {updatedLabel}</li>
        <li><a class="chip chip-accent" href="/methodology/"><Icon name="checkCircle" size={15} />Tested</a></li>
      </ul>
    </div>
  </div>
  <div class="page-wide">
    <slot />
  </div>

  <div class="guide-layout">
  <article class="guide">
    <div class="guide-body"><slot name="guide" /></div>
    <div class="guide-end" hidden></div>
    <AdSlot name="guide" />
    <FAQ faqs={guide.faqs} />
    <RelatedCalculators country={country} calculators={relatedFor(calc, country.code)} />
    <footer class="guide-meta">
      <p>Last updated <time datetime={guide.updated.toISOString().slice(0, 10)}>{updatedLabel}</time>.</p>
      {
        guide.sources.length > 0 && (
          <>
            <h2 class="h3">Sources</h2>
            <ul>
              {guide.sources.map((s) => (
                <li>
                  <a href={s.url} rel="noopener">
                    {s.name}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </footer>
    <Disclaimer />
  </article>
  {
    toc.length > 1 && (
      <nav class="toc" aria-labelledby="toc-title">
        <p class="toc-title" id="toc-title">On this page</p>
        <ol>
          {toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
          <li><a href="#faq-title">Frequently asked questions</a></li>
          <li><a href="#related-title">Related calculators</a></li>
        </ol>
      </nav>
    )
  }
  </div>
</BaseLayout>

