---
/**
 * System / light / dark as a radio group (arrow keys move between options). The choice is saved in
 * localStorage and applied before first paint by the inline script in BaseLayout's <head>.
 */
import Icon from './Icon.astro';

interface Props {
  /** Unique per instance (the header and the mobile menu each have one). */
  id: string;
  class?: string;
}

const { id, class: className } = Astro.props;
const options = [
  { value: 'system', label: 'System', icon: 'monitor' },
  { value: 'light', label: 'Light', icon: 'sun' },
  { value: 'dark', label: 'Dark', icon: 'moon' },
] as const;
---

<fieldset class:list={['theme-toggle segmented', className]} data-theme-toggle>
  <legend class="visually-hidden">Colour theme</legend>
  {
    options.map((o) => (
      <label title={o.label}>
        <input type="radio" name={`theme-${id}`} value={o.value} checked={o.value === 'system'} />
        <Icon name={o.icon} size={18} />
        <span class="visually-hidden">{o.label}</span>
      </label>
    ))
  }
</fieldset>

