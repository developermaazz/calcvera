---
/**
 * Calculator card: inputs on the left, live results on the right from 1024px (stacked below that).
 * The engine-specific component fills the two slots and wires up the behaviour. This shell adds display-only
 * hooks for display-only polish wired up in src/scripts/site.ts (count-up, chart grow-in, mobile result bar).
 * None of it touches the calculation.
 */
import Icon from './Icon.astro';

interface Props {
  /** Unique id; the form gets `${id}-form`. */
  id: string;
  /** Accessible name for the calculator section. */
  label: string;
}

const { id, label } = Astro.props;
---

<section class="calc card" aria-labelledby={`${id}-title`} data-calc-shell>
  <h2 id={`${id}-title`} class="visually-hidden">{label}</h2>
  <div class="calc-grid">
    <form id={`${id}-form`} class="calc-inputs" novalidate autocomplete="off">
      <slot name="inputs" />
    </form>
    <div class="calc-results">
      <slot name="results" />
    </div>
  </div>
  <div class="result-bar" aria-hidden="true" data-result-bar>
    <div>
      <span class="result-bar-label" data-bar-label></span>
      <span class="result-bar-value" data-bar-value></span>
    </div>
    <a href={`#${id}-breakdown`} tabindex="-1" data-bar-link>See breakdown <Icon name="arrowRight" size={16} /></a>
  </div>
</section>

