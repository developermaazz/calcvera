---
/** Visible FAQ as accordions (the answers stay in the HTML). The same questions feed the FAQPage JSON-LD. */
interface Props {
  faqs: { q: string; a: string }[];
}

const { faqs } = Astro.props;
---

<section class="faq" aria-labelledby="faq-title">
  <h2 id="faq-title">Frequently asked questions</h2>
  <div class="faq-list">
    {
      faqs.map((item, i) => (
        <details class="faq-item" open={i === 0}>
          <summary>
            <h3>{item.q}</h3>
          </summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
