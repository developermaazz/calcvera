---
/**
 * Country links as a segmented pill with flags. On calculator pages each country links to the same calculator
 * there (falls back to the country hub). Remembers the choice so the banner stops suggesting another country.
 */
import { LAUNCHED_COUNTRIES, type CountryCode } from '../countries';
import Flag from './Flag.astro';

interface Props {
  current?: CountryCode;
  /** Paths of this page in other countries; falls back to the country hub. */
  alternates?: Partial<Record<CountryCode, string>>;
  /** Accessible name; two switchers can be on a page (header and mobile menu). */
  label?: string;
  class?: string;
}

const { current, alternates = {}, label = 'Choose your country', class: className } = Astro.props;
---

<nav class:list={['country-switcher', className]} aria-label={label}>
  <ul class="segmented">
    {
      LAUNCHED_COUNTRIES.map((c) => (
        <li>
          <a
            href={alternates[c.code] ?? `/${c.code}/`}
            hreflang={c.hreflang}
            aria-current={c.code === current ? 'page' : undefined}
            data-set-country={c.code}
            title={c.name}
          >
            <Flag code={c.code} size={18} />
            <span aria-hidden="true">{c.code.toUpperCase()}</span>
            <span class="visually-hidden">{c.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

